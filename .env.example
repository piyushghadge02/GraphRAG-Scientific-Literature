# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here
# Groq API Keys (KEY1 is required, KEY2 and KEY3 are optional rate-limit fallbacks)
GROQ_API_KEY1=your-first-groq-key-here
GROQ_API_KEY2=your-second-groq-key-here
GROQ_API_KEY3=your-third-groq-key-here

# LLM Selection Settings
LLM_BACKEND=groq
LLM_MODEL=openai/gpt-oss-120b

# Streamlit → FastAPI backend URL (Step 3: UI calls POST {URL}/query)
GRAPHRAG_API_URL=http://localhost:8000


# RAG & Embedding Settings (Phase 1)
# PDF-required baseline: all-MiniLM-L6-v2 (384D). Do not remove this default.
# Experiment A (baseline): leave EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# Experiment B (custom):   set EMBEDDING_MODEL_NAME to another
#   SentenceTransformer model (e.g. all-mpnet-base-v2). Switching models
#   requires re-embedding all chunks AND explicitly recreating the vector
#   index (it is never dropped automatically):
#     python -m src.graph.build_graph --recreate-vector-index
#   because stored 384D vectors and the index dimension will no longer match.
#   No second index is created.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# PDF-required semantic-clustering model. MUST stay all-MiniLM-L6-v2 in Phase 1.
SEMANTIC_CLUSTER_MODEL_NAME=all-MiniLM-L6-v2
CHUNK_TOKEN_LIMIT=100
TOP_K_DEFAULT=5
SEMANTIC_SIMILARITY_THRESHOLD=0.85
# Hybrid fusion weight: fraction of vector similarity in the final ranking
# (Phase 1: configurable + explainable; default reproduces legacy behavior).
ALPHA_FUSION_WEIGHT=0.7

# Phase 2 — GraphRAG improvements (all optional; defaults preserve behavior)
# Graph expansion through shared entities (Chunk->Entity->Chunk, depth <= 2).
GRAPH_EXPANSION_ENABLED=true
GRAPH_MAX_DEPTH=1
GRAPH_MAX_EXPANDED_CHUNKS=500
GRAPH_MIN_SHARED_ENTITIES=2
GRAPH_MIN_SIMILARITY=0.3
# Optional hub-entity guard (0 = disabled; bounds MENTIONS degree in expansion).
GRAPH_MAX_ENTITY_DEGREE=0
# 3-term fusion: alpha*vector + beta*entity + gamma*proximity, rescaled to
# sum to 1 (defaults reproduce the Phase 1 ranking exactly).
FUSION_BETA_WEIGHT=0.3
FUSION_GAMMA_WEIGHT=0.0
# PageRank reranking over the retrieved subgraph only (optional).
ENABLE_PAGERANK=true
PAGERANK_WEIGHT=0.15
PAGERANK_MAX_ITERATIONS=20
PAGERANK_DAMPING_FACTOR=0.85
# Adaptive retrieval: skip graph expansion when vector retrieval is already
# high-confidence (deterministic, rule-based, logged).
ADAPTIVE_RETRIEVAL_ENABLED=true
ADAPTIVE_TOP1_THRESHOLD=0.90
ADAPTIVE_GAP_THRESHOLD=0.05
